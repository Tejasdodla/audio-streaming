 * DeviceTree Overlay for nRF54L15 Audio Receiver with MAX98357A & Storage
 */

/ {
	aliases {
		i2s-audio = &i2s20;
	};
};

/* Pin control configuration for I2S output to MAX98357A */
&pinctrl {
	i2s20_default: i2s20_default {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 1, 12)>,
				<NRF_PSEL(I2S_LRCK_M, 1, 11)>,
				<NRF_PSEL(I2S_SDOUT, 1, 13)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	i2s20_sleep: i2s20_sleep {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 1, 12)>,
				<NRF_PSEL(I2S_LRCK_M, 1, 11)>,
				<NRF_PSEL(I2S_SDOUT, 1, 13)>;
			low-power-enable;
		};
	};
};

/* Disable button0 on P1.13 so P1.13 is fully dedicated to I2S DIN */
&button0 {
	status = "disabled";
};

/* Enable I2S20 peripheral */
&i2s20 {
	status = "okay";
	pinctrl-0 = <&i2s20_default>;
	pinctrl-1 = <&i2s20_sleep>;
	pinctrl-names = "default", "sleep";
};
