  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\CID\Desktop\5th-sense\audio-streaming\firmware\build\firmware\zephyr\soc\common && C:\Users\CID\AppData\Local\Programs\Python\Python312\Lib\site-packages\cmake\data\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

